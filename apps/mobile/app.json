{
  "expo": {
    "name": "MyAlgoDesk",
    "slug": "myalgodesk-mobile",
    "version": "1.0.0",
    "scheme": "nraialgo",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.myalgodesk.mobile"
    },
    "android": {
      "package": "in.myalgodesk.mobile",
      "versionCode": 1,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-maskable.png",
        "backgroundColor": "#00164A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#00164A"
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3cd7182a-5684-40bb-a491-3880c508287a"
      }
    }
  }
}
